    {
      "id": "customer-top-spend-001",
      "category": "aggregation",
      "difficulty": "medium",
      "question": "총 구매 금액이 가장 높은 고객 5명의 이름, 성, 총 구매 금액을 내림차순으로 알려줘.",
      "gold_sql": "SELECT c.FirstName, c.LastName, ROUND(SUM(i.Total), 2) AS TotalSpent FROM Customer c JOIN Invoice i ON c.CustomerId = i.CustomerId GROUP BY c.CustomerId, c.FirstName, c.LastName ORDER BY TotalSpent DESC, c.CustomerId ASC LIMIT 5",
      "max_retries": 3,
      "expected_rows": [
        [
          "Helena",
          "Holý",
          49.62
        ],
        [
          "Richard",
